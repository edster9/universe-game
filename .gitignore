# Build output
/target
# Prototypes build on their own
target/
# Benchmark output written where it runs
gpu-bench-*.txt
!prototypes/gpu-bench/results/*.txt

# Personal editor and assistant settings
.claude/settings.local.json
.vscode/
.idea/
*.swp
.DS_Store
# Patched copies of libraries, made by a script (client/vendor.sh)
vendor/

# Secrets: API keys, kept on this machine only
.env
.env.*
/saves/

# Third-party asset packs: never in git (size and licences); only each
# pack's README, saying what to download and where it goes.
/assets/third-party/**
!/assets/third-party/**/
!/assets/third-party/**/README.md
# Blender: the catalogue holds the packs' models, so it's made by a script,
# never kept; and Blender's backup copies.
/blender/catalogue.blend
*.blend1

# Worlds exported from Blender: they hold the packs' models.
/assets/worlds/

# The source worlds, built in Blender: temporary while we train the system,
# kept in S3 (blender/worlds.sh), not in git. Only the folder's README is.
/worlds/*
!/worlds/README.md

# Python's compiled copies.
__pycache__/

# Forests for the rendering benchmarks: made by blender/make_forest.py.
/data/forest-*.toml

# Made from the packs (pictures of their models for drawing far away): not in git, like them.
/assets/generated/
